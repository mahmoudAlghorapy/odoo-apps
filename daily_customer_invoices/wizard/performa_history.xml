<odoo>
    <record id="daily_journal_form_view" model="ir.ui.view">
        <field name="name">daily.journal.wizard.form</field>
        <field name="model">daily.journal.wizard</field>
        <field name="arch" type="xml">
            <form string="Daily Journal Sales">
                <sheet>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>

                        </group>
                        <group>
                            <field name="journal_id"
                                   options="{'no_create_edit': True,'no_create':True,'no_edit':True}"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_view_report" string="Print" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>

            </form>
        </field>
    </record>

    <record id="performa_history_action_view" model="ir.actions.act_window">
        <field name="name">Performa History</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">daily.journal.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="daily_journal_form_view"/>
        <field name="target">new</field>
    </record>


    <menuitem id="performa_history_menu" name="Daily Customer Invoices"  parent="account.menu_finance_receivables"
              action="performa_history_action_view" sequence="203"/>
</odoo>